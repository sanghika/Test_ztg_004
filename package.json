{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && npm run build:prerender && node scripts/precompress.mjs && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist-server/server.cjs",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "build:prerender": "npm run build:ssr && node scripts/prerender.mjs",
    "build:precompress": "node scripts/precompress.mjs",
    "start": "node dist-server/server.cjs",
    "preview": "vite preview",
    "analyze": "npx --yes vite-bundle-visualizer",
    "screenshots": "node scripts/screenshots.mjs",
    "clean": "rm -rf dist dist-ssr dist-server server.js",
    "lint": "tsc --noEmit && eslint \"**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "python3 -m unittest discover -s scripts -p 'test_*.py'"
  },
  "dependencies": {
    "@octokit/core": "^7.0.6",
    "@octokit/plugin-paginate-rest": "^14.0.0",
    "@octokit/plugin-rest-endpoint-methods": "^17.0.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.5",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.2",
    "web-vitals": "5.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.2.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "body-parser": "^1.20.9",
    "express": {
      "proxy-addr": "^2.0.8",
      "qs": "^6.17.1"
    },
    "express-rate-limit": {
      "ip-address": "^10.7.6"
    }
  }
}
